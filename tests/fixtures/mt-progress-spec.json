        "progressBar"
      ],
      "message_text_size_sp": 16,
      "message_margin_top_dp": 8,
      "message_margin_top_with_text_dp": 6,
      "progress_margin_top_dp": 12,
      "cancelable": false,
      "updaters": [
        "title",
        "message",
        "progress",
        "secondaryProgress"
      ],
      "methods": [
        "setTitle",
        "setMessage",
        "setProgress",
        "setSecondaryProgress",
        "setMaxProgress",
        "setIndeterminate",
        "show",
        "dismiss",
        "isShowing"
      ]
    },
