diff --git a/app/src/main/assets/style.css b/app/src/main/assets/style.css
index 7cbfc3e..c3d61e2 100755
--- a/app/src/main/assets/style.css
+++ b/app/src/main/assets/style.css
@@ -101,7 +101,7 @@ button:focus-visible,a:focus-visible{outline:2px solid var(--blue)}
 .breadcrumbs{padding:9px 13px;color:#aebdcc;font-size:12px;background:#252525;overflow-wrap:anywhere}
 .editorInfo{height:22px;display:flex;align-items:center;justify-content:space-between;padding:0 15px;font-size:12px;line-height:20px;background:var(--bar);border-bottom:1px solid var(--line)}
 .editorInfo span:first-child{max-width:75%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
-.CodeMirror{height:100%;font-family:'Droid Sans Mono',monospace;font-size:12px;line-height:1.4;background:var(--code);color:#b4bec8}
+.CodeMirror{height:100%;font-family:"JetBrains Mono","Droid Sans Mono",monospace;font-size:12px;line-height:1.4;background:var(--code);color:#b4bec8}
 .CodeMirror-gutters{background:var(--gutter);border-right:1px solid #4b4b4b}
 .CodeMirror-linenumber{color:#888;min-width:0;padding:0 3px 0 2px}
 .CodeMirror-lines{padding:0}
@@ -402,7 +402,7 @@ body.light .pane:not(.active){background:#f2f2f2}
   --text:#f2f2f3;--muted:#9a9ca3;--faint:#8a8c92;
   --accent:#4a8ad6;--positive:#5fc39c;--negative:#e5566f;--warning:#d9a441;
   --radius-card:6px;--radius-control:8px;--radius-pill:999px;
-  --mono:monospace;
+  --mono:"JetBrains Mono","Droid Sans Mono",monospace;
   --bg:var(--ground);--bar:var(--ground);--code:#131217;--dialog:var(--raised);
   --line:var(--border);--blue:var(--accent);--icon:transparent;--hover:var(--raised);--gutter:#1b1b20;
 }
@@ -692,6 +692,10 @@ body.light .multidexDialog .dexPickIcon,body.light .optionIcon{color:var(--muted
 .dialog.dangerDialog:not(.stackedActions) .actions button:last-child{background:var(--negative);border-color:var(--negative);color:#fff}
 /* bundled face + file list as a two-line table row */
 @font-face{font-family:"Public Sans";src:url("fonts/PublicSans.woff2") format("woff2");font-weight:100 900;font-style:normal;font-display:swap}
+/* Bundled monospace face: identical code alignment on every ROM (MT ships Mono.ttf). */
+@font-face{font-family:"JetBrains Mono";src:url("fonts/JetBrainsMono-Regular.woff2") format("woff2");font-weight:400;font-style:normal;font-display:swap}
+.findOpts{margin:6px 0 2px}
+.findOpts .toggleRow{min-height:36px;font-size:13px!important}
 body{font-family:"Public Sans",Roboto,"Noto Sans SC","Noto Sans CJK SC",system-ui,-apple-system,sans-serif}
 h1.title,h1.editorTitle{margin:0}
 .fileline{display:flex;align-items:baseline;gap:8px;min-width:0}
diff --git a/app/src/main/assets/vendor/brainfuck.js b/app/src/main/assets/vendor/brainfuck.js
new file mode 100644
index 0000000..b5a30f8
--- /dev/null
+++ b/app/src/main/assets/vendor/brainfuck.js
@@ -0,0 +1,85 @@
+// CodeMirror, copyright (c) by Marijn Haverbeke and others
+// Distributed under an MIT license: https://codemirror.net/5/LICENSE
+
+// Brainfuck mode created by Michael Kaminsky https://github.com/mkaminsky11
+
+(function(mod) {
+  if (typeof exports == "object" && typeof module == "object")
+    mod(require("../../lib/codemirror"))
+  else if (typeof define == "function" && define.amd)
+    define(["../../lib/codemirror"], mod)
+  else
+    mod(CodeMirror)
+})(function(CodeMirror) {
+  "use strict"
+  var reserve = "><+-.,[]".split("");
+  /*
+  comments can be either:
+  placed behind lines
+
+        +++    this is a comment
+
+  where reserved characters cannot be used
+  or in a loop
+  [
+    this is ok to use [ ] and stuff
+  ]
+  or preceded by #
+  */
+  CodeMirror.defineMode("brainfuck", function() {
+    return {
+      startState: function() {
+        return {
+          commentLine: false,
+          left: 0,
+          right: 0,
+          commentLoop: false
+        }
+      },
+      token: function(stream, state) {
+        if (stream.eatSpace()) return null
+        if(stream.sol()){
+          state.commentLine = false;
+        }
+        var ch = stream.next().toString();
+        if(reserve.indexOf(ch) !== -1){
+          if(state.commentLine === true){
+            if(stream.eol()){
+              state.commentLine = false;
+            }
+            return "comment";
+          }
+          if(ch === "]" || ch === "["){
+            if(ch === "["){
+              state.left++;
+            }
+            else{
+              state.right++;
+            }
+            return "bracket";
+          }
+          else if(ch === "+" || ch === "-"){
+            return "keyword";
+          }
+          else if(ch === "<" || ch === ">"){
+            return "atom";
+          }
+          else if(ch === "." || ch === ","){
+            return "def";
+          }
+        }
+        else{
+          state.commentLine = true;
+          if(stream.eol()){
+            state.commentLine = false;
+          }
+          return "comment";
+        }
+        if(stream.eol()){
+          state.commentLine = false;
+        }
+      }
+    };
+  });
