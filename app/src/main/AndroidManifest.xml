<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.cyberhub.manager">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <queries><package android:name="moe.shizuku.privileged.api" /></queries>
  <!-- Shizuku v11+ 服务端的 BinderSender 只向「声明了 API_V23 权限」的客户端推送 binder：
       sendBinder() 遍历应用的 requestedPermissions，含 PERMISSION(API_V23) 才调 sendBinderToUserApp，
       否则直接 continue。本项目由 aapt2 直接打包，没有 Gradle manifest merger，官方 provider AAR
       不会自动注入该权限；缺了它服务端根本不会把 binder 送到本应用，pingBinder() 恒为 false。
       与 MT 管理器 2.26.11 的接入声明保持一致。 -->
  <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
  <application android:theme="@style/AppTheme" android:label="赛博中枢管家" android:icon="@drawable/ic_launcher" android:allowBackup="false" android:usesCleartextTraffic="true" android:supportsRtl="true" android:largeHeap="true">
    <!-- v3 客户端标记：Shizuku Manager 据此把本应用列入「应用管理」授权列表。 -->
    <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />
    <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize">
      <!-- The LAUNCHER filter lives on the icon aliases below: exactly one alias is
           enabled at a time, so switching icons never duplicates chooser rows. -->
      <!-- One "Open with" entry for every kind of file. A single WebView UI handles
           them all, so one filter here avoids the duplicate chooser rows that
           separate per-media activity aliases would create. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <action android:name="android.intent.action.EDIT" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="content" />
        <data android:scheme="file" />
        <data android:mimeType="*/*" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="*/*" />
      </intent-filter>
    </activity>
    <activity-alias android:name=".MainActivityDefault" android:targetActivity=".MainActivity" android:exported="true" android:enabled="true" android:icon="@drawable/ic_launcher" android:label="赛博中枢管家">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity-alias>
    <activity-alias android:name=".MainActivityBlue" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false" android:icon="@drawable/ic_launcher_blue" android:label="赛博中枢管家 · 极光蓝">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity-alias>
    <activity-alias android:name=".MainActivityGreen" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false" android:icon="@drawable/ic_launcher_green" android:label="赛博中枢管家 · 矩阵绿">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity-alias>
    <activity android:name=".player.MediaPlayerActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden" android:launchMode="singleTop" />
    <activity android:name=".preview.HtmlPreviewActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden" />
    <provider android:name=".ShareProvider" android:authorities="com.cyberhub.manager.files" android:exported="false" android:grantUriPermissions="true" />
    <provider android:name="rikka.shizuku.ShizukuProvider" android:authorities="com.cyberhub.manager.shizuku" android:enabled="true" android:exported="true" android:multiprocess="false" android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <service android:name=".color.ColorPickerService" android:enabled="true" android:exported="false" android:foregroundServiceType="mediaProjection" />
  </application>
</manifest>
